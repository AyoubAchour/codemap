      "tags": ["docs", "semantic", "benchmark"]
    },
    {
      "id": "tests-retrieval-benchmark",
      "query": "benchmark thresholds precision recall MRR fixture suite tests",
      "expected_files": [
        "test/unit/retrieval_benchmark.test.ts",
        "src/retrieval_benchmark.ts"
      ],
      "tags": ["tests", "benchmark"]
    },
    {
      "id": "optional-semantic-gating",
      "query": "optional embeddings reranker local first gated by benchmark misses not required cloud",
      "expected_files": [
        "tasks/task-052-semantic-retrieval-layer.md",
        "src/retrieval_benchmark.ts"
      ],
      "supporting_files": [
        "tasks/task-055-retrieval-benchmark-suite.md"
      ],
      "forbidden_files": [
        "src/capture_report.ts"
      ],
      "expected_result_sources": ["source"],
      "tags": ["semantic", "embeddings", "benchmark", "guardrail"]
    },
    {
      "id": "agent-lifecycle-writeback",
      "query": "repo agent should call suggest_writeback before ending and avoid graph writes for unrelated read only research",
      "expected_files": [
        "src/tools/suggest_writeback.ts"
      ],
      "supporting_files": [
        "AGENTS.md",
        "src/writeback_suggestions.ts"
      ],
      "forbidden_files": [
        "src/local_semantic_provider.ts"
      ],
      "expected_result_sources": ["source"],
      "tags": ["agent-compliance", "writeback", "accuracy", "guardrail"]
    },
    {
      "id": "recall-payload-gates",
      "query": "compact recall payload budget compliance latency response bytes thresholds benchmark",
      "expected_files": [
        "src/retrieval_benchmark.ts",
        "tasks/task-058-recall-benchmark-parity.md"
      ],
      "response_budget_bytes": 65000,
      "expected_result_sources": ["source"],
      "tags": ["optimization", "payload", "recall", "benchmark"]
    }
  ]
}

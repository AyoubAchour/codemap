{
  "version": 1,
  "name": "Codemap local retrieval baseline",
  "description": "Repo-owned queries for measuring Codemap's current lexical, symbol, graph, and source-index retrieval before adding optional embeddings or reranking.",
  "queries": [
    {
      "id": "query-context-planning",
      "query": "fused query_context planning graph source staleness dependency impact",
      "expected_files": [
        "src/query_context.ts",
        "src/tools/query_context.ts"
      ],
      "forbidden_files": [
        "src/capture_report.ts"
      ],
      "expected_warnings": [
        "Source hits come from the rebuildable local index"
      ],
      "expected_result_sources": ["source"],
      "tags": ["query-context", "planning", "provenance", "guardrail"]
    },
    {
      "id": "diff-impact-analysis",
      "query": "changes_context git diff changed files likely tests docs writeback suggestions",
      "expected_files": [
        "src/changes_context.ts",
        "src/tools/changes_context.ts"
      ],
      "supporting_files": [
        "src/cli/changes_context.ts"
      ],
      "tags": ["diff", "impact"]
    },
    {
      "id": "repo-guidance-area-slices",
      "query": "generate-skills repo guidance area hashes area drift root area",
      "expected_files": [
        "src/repo_guidance.ts",
        "src/cli/generate_skills.ts"
      ],
      "tags": ["guidance", "onboarding"]
    },
    {
      "id": "ast-source-indexing",
      "query": "TypeScript AST indexing symbols imports exports exact identifier references",
      "expected_files": [
        "src/source_index.ts"
      ],
      "supporting_files": [
        "test/unit/source_index.test.ts"
      ],
      "tags": ["source-index", "ast"]
    },
    {
      "id": "graph-health-staleness",
      "query": "graph health source anchor staleness duplicate aliases validator warnings doctor",
      "expected_files": [
        "src/graph_health.ts"
      ],
      "supporting_files": [
        "src/cli/doctor.ts",
        "src/tools/graph_health.ts"
      ],
      "tags": ["graph-health", "staleness"]
    },
    {
      "id": "global-client-setup",
      "query": "setup global MCP clients Codex Cursor OpenCode Claude install health",
      "expected_files": [
        "src/setup.ts",
        "src/cli/setup.ts",
        "bin/codemap.ts"
      ],
      "tags": ["setup", "onboarding"]
    },
    {
      "id": "semantic-agent-onboarding",
      "query": "make coding agents follow repo memory lifecycle without relying on chat reminders guidance freshness contract",
      "expected_files": [
        "src/instructions.ts",
        "src/guidance.ts"
      ],
      "supporting_files": [
        "src/setup.ts"
      ],
      "forbidden_files": [
        "src/local_semantic_provider.ts"
      ],
      "expected_result_sources": ["source"],
      "tags": ["semantic", "onboarding", "agent-compliance", "guardrail"]
    },
    {
      "id": "typo-source-index",
      "query": "sorce indx frshness seach chunks symbols stale files",
      "expected_files": [
        "src/source_index.ts"
      ],
      "supporting_files": [
        "src/tools/search_source.ts",
        "src/tools/get_index_status.ts"
      ],
      "tags": ["typo", "source-index"]
    },
    {
      "id": "cross-file-change-impact",
      "query": "after a diff what imports this what tests docs and writeback are likely affected",
      "expected_files": [
        "src/changes_context.ts"
      ],
      "supporting_files": [
        "src/source_index.ts",
        "src/writeback_suggestions.ts",
        "test/unit/cli.test.ts"
      ],
      "tags": ["impact", "cross-file", "tests"]
    },
    {
      "id": "renamed-reexport-ast",
      "query": "renamed re-export local symbol as public export AST extraction should not leak local name",
      "expected_files": [
        "src/source_index.ts"
      ],
      "supporting_files": [
        "test/unit/source_index.test.ts"
      ],
      "tags": ["renamed-symbol", "source-index", "ast"]
    },
    {
      "id": "stale-graph-anchor-repair",
      "query": "stale graph source anchors unchanged ranges legacy reanchor repair proposals",
      "expected_files": [
        "src/graph_repair.ts"
      ],
      "supporting_files": [
        "src/graph_health.ts",
        "src/staleness.ts"
      ],
      "tags": ["stale-graph", "repair", "memory-quality"]
    },
    {
      "id": "docs-task-055",
      "query": "larger retrieval benchmark suite semantic typo docs tests fixture retrieval complexity before embeddings",
      "expected_files": [
        "tasks/task-055-retrieval-benchmark-suite.md"
      ],
      "supporting_files": [
        "tasks/task-052-semantic-retrieval-layer.md",

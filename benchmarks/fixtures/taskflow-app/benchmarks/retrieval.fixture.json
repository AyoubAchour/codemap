{
  "version": 1,
  "name": "Taskflow fixture retrieval suite",
  "description": "Small non-Codemap repository used to benchmark semantic wording, typos, docs, tests, renamed exports, and cross-file impact.",
  "queries": [
    {
      "id": "semantic-session-policy",
      "query": "who checks whether a person can manage workspace project tasks before work starts",
      "expected_files": [
        "src/auth/session.ts"
      ],
      "forbidden_files": [
        "src/notifications/email.ts"
      ],
      "expected_result_sources": ["source"],
      "tags": ["semantic", "auth", "guardrail"]
    },
    {
      "id": "typo-task-creation",
      "query": "creat prject tsk owner assignmnt createProjectTask",
      "expected_files": [
        "src/projects/tasks.ts",
        "src/projects/rename.ts"
      ],
      "tags": ["typo", "renamed-symbol"]
    },
    {
      "id": "cross-file-impact",
      "query": "changing task assignment touches creator notifications and tests",
      "expected_files": [
        "src/projects/tasks.ts",
        "src/projects/rename.ts",
        "src/notifications/email.ts",
        "test/tasks.fixture.ts"
      ],
      "tags": ["impact", "tests"]
    },
    {
      "id": "docs-runbook",
      "query": "handoff queue service level operations documentation overdue digest policy",
      "expected_files": [
        "docs/operations.md"
      ],
      "forbidden_files": [
        "docs/archive.md"
      ],
      "expected_warnings": [
        "Source hits come from the rebuildable local index"
      ],
      "expected_result_sources": ["source"],
      "tags": ["docs", "semantic", "provenance"]
    },
    {
      "id": "notification-digest",
      "query": "email digest overdue tasks owner notification",
      "expected_files": [
        "src/notifications/email.ts"
      ],
      "forbidden_files": [
        "src/auth/session.ts"
      ],
      "expected_result_sources": ["source"],
      "tags": ["semantic", "notifications", "guardrail"]
    },
    {
      "id": "test-discovery",
      "query": "assignment behaviour test assert owner field",
      "expected_files": [
        "test/tasks.fixture.ts"
      ],
      "tags": ["tests"]
    },
    {
      "id": "distractor-runbook-policy",
      "query": "where is the service level target for overdue task digest handoff documented",
      "expected_files": [
        "docs/operations.md"
      ],
      "forbidden_files": [
        "docs/archive.md"
      ],
      "response_budget_bytes": 16000,
      "expected_result_sources": ["source"],
      "tags": ["docs", "distractor", "payload", "semantic", "guardrail"]
    },
    {
      "id": "assignment-noisy-impact",
      "query": "if task assignment notification output changes what implementation and test files need review",
      "expected_files": [
        "src/projects/tasks.ts",
        "src/notifications/email.ts",
        "test/tasks.fixture.ts"
      ],
      "forbidden_files": [
        "src/notifications/slack.ts"
      ],
      "response_budget_bytes": 16000,
      "expected_result_sources": ["source"],
      "tags": ["impact", "distractor", "tests", "payload", "guardrail"]
    }
  ]
}
